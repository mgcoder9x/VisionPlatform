@echo off
REM ============================================================================
REM  MAU profile rieng theo may. COPY file nay -> scripts\env.local.cmd
REM  (env.local.cmd da duoc .gitignore -> KHONG commit, moi may 1 ban rieng).
REM
REM  vp.cmd se `call` file nay (neu ton tai) TRUOC khi tu-do moi truong,
REM  nen cac bien dat o day se GHI DE auto-detect.
REM ============================================================================

REM --- Ep interpreter base (khi auto-detect chon sai / muon phien ban cu the) ---
REM set "VP_PYTHON=py -3.11"
REM set "VP_PYTHON=python"

REM --- Ep pip extras (mac dinh baseline: dev,onnx,cv2,web — KHONG torch) ---
REM May CO GPU + muon chay YOLO that (torch): them 'pt' (luu y K-049: tren Windows
REM `pip install .[pt]` co the keo torch CPU-only; can CUDA wheel rieng neu muon GPU).
REM set "VP_EXTRAS=dev,onnx,cv2,web,pt"
