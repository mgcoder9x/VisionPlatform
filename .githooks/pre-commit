#!/bin/sh
# ============================================================================
#  pre-commit — CONG CHONG-DRIFT LOCAL (versioned, dung chung moi may).
#
#  BAN CHAT: bat drift SOM NHAT (luc commit) thay vi sau push (CI verify.yml).
#  Phong-thu-nhieu-lop: (1) hook agentStop [AI moi luot] -> (2) pre-commit [local,
#  moi commit, file nay] -> (3) CI [server-side, moi push/PR]. Drift KHONG the
#  vao lich su git neu hook bat.
#
#  CHI chay drift_check.py (nhanh vai giay) — KHONG pytest/lint (cham -> bi bypass);
#  full verify de `vp verify` + CI. Exit !=0 => chan commit.
#
#  Kich hoat 1 lan/clone: `scripts\vp.cmd install-hooks` (dat core.hooksPath=.githooks).
#  Bo qua co chu dich 1 lan: `git commit --no-verify` (KHONG khuyen khich).
#  Discovery Python bam tests/drift_check.cmd: py -3 -> venv du an -> python.
# ============================================================================
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1
SCRIPT="tests/drift_check.py"
VENV="vision-platform/.venv/Scripts/python.exe"

if py -3 --version >/dev/null 2>&1; then
  py -3 "$SCRIPT"; rc=$?
elif [ -x "$VENV" ]; then
  "$VENV" "$SCRIPT"; rc=$?
elif python --version >/dev/null 2>&1; then
  python "$SCRIPT"; rc=$?
else
  echo "[pre-commit] ERROR: khong tim thay Python (da thu: py -3, venv, python)." >&2
  exit 9009
fi

if [ "$rc" -ne 0 ]; then
  echo "" >&2
  echo "[pre-commit] DRIFT-CHECK FAIL (rc=$rc) — COMMIT BI CHAN." >&2
  echo "  Ban ghi (LOG / INDEX / journal / activeContext) lech thuc te." >&2
  echo "  Sua cho khop roi commit lai. (Bo qua co chu dich: git commit --no-verify)" >&2
  exit 1
fi

# --- COng 2: SECRET-SCAN (K-031) — chan secret THAT truoc khi vao history (rewrite history = viec dau).
#     Chi mau do-tin-cay-CAO (private key/AKIA/sk-/ghp_/xox/AIza + file .env|.pem|.key|id_rsa) => FP ~ 0.
#     URL co credential chi WARN (repo CO Y dung placeholder) — xem tests/secret_scan.py.
SECRETS="tests/secret_scan.py"
if py -3 --version >/dev/null 2>&1; then
  py -3 "$SECRETS" >/dev/null 2>&1; src=$?
elif [ -x "$VENV" ]; then
  "$VENV" "$SECRETS" >/dev/null 2>&1; src=$?
elif python --version >/dev/null 2>&1; then
  python "$SECRETS" >/dev/null 2>&1; src=$?
else
  src=0   # khong co Python: drift-check o tren da bao loi 9009 truoc do
fi

if [ "$src" -ne 0 ]; then
  echo "" >&2
  echo "[pre-commit] SECRET-SCAN FAIL (rc=$src) — COMMIT BI CHAN." >&2
  echo "  Co secret that / file bi cam (.env|.pem|.key|id_rsa) trong file tracked." >&2
  echo "  Chi tiet: scripts\\vp.cmd secrets    → XOA khoi repo + ROTATE key da lo." >&2
  echo "  (Bo qua co chu dich: git commit --no-verify — CHI khi chac chan la false positive)" >&2
  exit 1
fi
exit 0
