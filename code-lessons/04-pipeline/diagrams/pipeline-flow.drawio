        <mxCell id="err" value="ERROR&#10;stage loi (can alert)&#10;error_type + error_message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;" vertex="1" parent="1">
          <mxGeometry x="750" y="400" width="170" height="70" as="geometry" />
        </mxCell>

        <mxCell id="note" value="Vi sao result-object thay Optional[MediaPacket]? None khong phan biet 'bo co y' (SKIPPED) voi 'loi' (ERROR)." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#666666;fontStyle=2;" vertex="1" parent="1">
