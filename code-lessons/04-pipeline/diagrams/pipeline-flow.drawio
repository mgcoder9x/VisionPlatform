        <mxCell id="skip" value="SKIPPED&#10;filter bo CO Y&#10;failed_stage + reason" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;" vertex="1" parent="1">
          <mxGeometry x="560" y="400" width="170" height="70" as="geometry" />
