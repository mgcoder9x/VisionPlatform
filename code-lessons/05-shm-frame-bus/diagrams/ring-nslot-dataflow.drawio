<mxfile host="app.diagrams.net" type="device">
  <diagram id="ring-nslot-dataflow" name="05 - SHM ring N-slot dataflow (writer -&gt; ring -&gt; reader)">
    <mxGraphModel dx="1100" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Bai #05 - SHM frame bus: writer -&gt; ring N-slot -&gt; reader (zero-copy, chep 1 lan)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1060" height="30" as="geometry" />
        </mxCell>

        <mxCell id="procA" value="Process A (camera)&#10;ShmFrameWriter.write(frame)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="ring" value="SHM ring buffer: N slot (per-slot lock)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=center;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="90" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="s0" value="slot 0&#10;header 256B + data" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="415" y="120" width="130" height="45" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="slot 1&#10;header 256B + data" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="555" y="120" width="130" height="45" as="geometry" />
        </mxCell>
        <mxCell id="sN" value="... slot N-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="415" y="180" width="270" height="40" as="geometry" />
        </mxCell>

        <mxCell id="procB" value="Process B (inference)&#10;ShmFrameReader.pin -&gt; arr.copy() -&gt; unpin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="120" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="refnote" value="ShmFrameRefData (con tro nhe: ring_name, slot, generation, ring_epoch) di qua wire - KHONG copy anh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="290" width="300" height="70" as="geometry" />
        </mxCell>

        <mxCell id="note" value="Zero-copy: writer chi chep data 1 LAN vao slot (WRITING -&gt; READY). Reader pin, arr.copy() roi unpin. Anh 6MB khong di qua ong; chi con tro nhe di qua wire." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#666666;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="1020" height="50" as="geometry" />
        </mxCell>

        <mxCell id="eW" value="1. copy data 1 lan -&gt; state=READY" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#6c8ebf;fontColor=#1a3d6d;" edge="1" parent="1" source="procA" target="ring">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eR" value="2. pin -&gt; copy -&gt; unpin" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#82b366;fontColor=#2d5a2d;" edge="1" parent="1" source="ring" target="procB">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eRef" value="tham chieu slot+generation" style="endArrow=classic;html=1;strokeWidth=1;dashed=1;strokeColor=#d6b656;fontColor=#6b5500;" edge="1" parent="1" source="refnote" target="procB">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
