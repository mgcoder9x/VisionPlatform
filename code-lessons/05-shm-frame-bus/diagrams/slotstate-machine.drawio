        <mxCell id="legend" value="Nhan canh = dieu kien + dong code that trong shm_frame_ring.py. QUARANTINED khong co canh ra (terminal): OS lock khong robust nen KHONG tai dung." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#666666;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="320" y="620" width="580" height="60" as="geometry" />
        </mxCell>

        <mxCell id="t2" value="writer claim: state in {FREE,DONE} &amp; reader_count==0 (L511) -&gt; set WRITING (L519)" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#6c8ebf;fontColor=#1a3d6d;fontSize=10;" edge="1" parent="1" source="free" target="writing">
